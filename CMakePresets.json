{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "base-win-vs2022",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      }
    },
    {
      "name": "base-win-vs2022-x64",
      "hidden": true,
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "x64",
        "strategy": "set"
      }
    },
    {
      "name": "base-win-ninja",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "architecture": {
        "value": "x86",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "base-buildtype-debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "base-buildtype-release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-msvc-dev-vs2022",
      "displayName": "Windows MSVC Win32 dev: Debug, static SDL2 + mixer, Bink (VS 2022)",
      "inherits": ["base-win-vs2022", "base-buildtype-debug"]
    },
    {
      "name": "win-msvc-release-vs2022",
      "displayName": "Windows MSVC Win32 release: Release, static SDL2 + mixer, Bink (VS 2022)",
      "inherits": ["base-win-vs2022", "base-buildtype-release"]
    },
    {
      "name": "win-msvc-dev-ninja",
      "displayName": "Windows MSVC Win32 dev: Debug, static SDL2 + mixer, Bink (Ninja, vcvars32)",
      "inherits": ["base-win-ninja", "base-buildtype-debug"]
    },
    {
      "name": "win-msvc-release-ninja",
      "displayName": "Windows MSVC Win32 release: Release, static SDL2 + mixer, Bink (Ninja, vcvars32)",
      "inherits": ["base-win-ninja", "base-buildtype-release"]
    },
    {
      "name": "win-msvc-dev-x64-vs2022",
      "displayName": "Windows MSVC x64 dev: Debug, static SDL2 + mixer, Bink (VS 2022)",
      "inherits": ["base-win-vs2022-x64", "base-buildtype-debug"]
    },
    {
      "name": "win-msvc-release-x64-vs2022",
      "displayName": "Windows MSVC x64 release: Release, static SDL2 + mixer, Bink (VS 2022)",
      "inherits": ["base-win-vs2022-x64", "base-buildtype-release"]
    }
  ],
  "buildPresets": [
    {
      "name": "win-msvc-dev-vs2022",
      "configurePreset": "win-msvc-dev-vs2022",
      "configuration": "Debug",
      "targets": ["tutankhamun"]
    },
    {
      "name": "win-msvc-release-vs2022",
      "configurePreset": "win-msvc-release-vs2022",
      "configuration": "Release",
      "targets": ["tutankhamun"]
    },
    {
      "name": "win-msvc-dev-ninja",
      "configurePreset": "win-msvc-dev-ninja",
      "targets": ["tutankhamun"]
    },
    {
      "name": "win-msvc-release-ninja",
      "configurePreset": "win-msvc-release-ninja",
      "targets": ["tutankhamun"]
    },
    {
      "name": "win-msvc-dev-x64-vs2022",
      "configurePreset": "win-msvc-dev-x64-vs2022",
      "configuration": "Debug",
      "targets": ["tutankhamun"]
    },
    {
      "name": "win-msvc-release-x64-vs2022",
      "configurePreset": "win-msvc-release-x64-vs2022",
      "configuration": "Release",
      "targets": ["tutankhamun"]
    }
  ]
}
